# Server
PORT=5000
NODE_ENV=development
# Local dev: http://localhost:5173
# Production: comma-separated list of allowed frontend origins, no trailing slash
#   e.g. https://attendance.redlecare.in,https://attendance-system.vercel.app
CLIENT_URL=http://localhost:5173

# Database (Supabase Postgres connection string — use the "Transaction pooler"
# connection string from Supabase Project Settings > Database, port 6543)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase (for Storage - face images / profile photos)
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security — never expose it to
# the frontend, never commit it, and rotate it if it's ever shared/leaked.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=attendance-files

# JWT — generate real secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Never reuse a value that has appeared in a chat, doc, or git history.
JWT_ACCESS_SECRET=replace-with-a-random-64-byte-hex-string
JWT_REFRESH_SECRET=replace-with-a-different-random-64-byte-hex-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
