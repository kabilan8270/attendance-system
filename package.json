{
  "name": "attendance-system",
  "version": "1.0.0",
  "description": "Attendance Management Desktop App",
  "main": "electron/main.js",
  "scripts": {
    "backend": "cd backend && pm2 restart attendance-api || pm2 start dist/server.js --name attendance-api",
    "frontend": "cd frontend && npm run preview",
    "electron": "electron .",
    "start": "concurrently -k \"npm run backend\" \"npm run frontend\" \"wait-on http://127.0.0.1:4173 && npm run electron\"",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.redlecare.attendance",
    "productName": "Attendance System",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}